# ============================================================
# Roman-Agenten – Testprofil für die Entwicklungsphase
# Kopieren nach .env.test. Alle Rollen nutzen das lokale Modell
# qwen3.5:9b über Ollama (Fallback: llama3.1:8b). Keine Cloud-Keys.
# ============================================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false              # Qwen-Denkmodus aus: schneller, sauberes JSON

DEFAULT_MODEL=ollama:qwen3.5:9b
TEST_FALLBACK_MODEL=ollama:llama3.1:8b
TEST_FALLBACK=false             # true = gezielt mit dem Fallback-Modell testen
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=4000

# Keine AGENT_*_MODEL-Überschreibungen: jede Rolle läuft auf DEFAULT_MODEL.
# Rollenspezifische Temperaturen dürfen gesetzt werden:
AGENT_CHAPTER_WRITER_TEMPERATURE=0.85
AGENT_CONTINUITY_TEMPERATURE=0.0
AGENT_GUARDRAILS_TEMPERATURE=0.0

# Websuche im Test aus: Recherche markiert alles als UNGEPRUEFT
AGENT_RESEARCH_WEB_SEARCH=false

# Kurze, schnelle Testläufe
MAX_REVISION_ROUNDS=1
WORD_COUNT_TOLERANCE=0.5
HUMAN_CHECKPOINTS=false

ENABLE_PROMPT_CACHING=false
USE_BATCH_API=false
MAX_BUDGET_USD=0

PROJECTS_DIR=./tests/fixtures
PROMPTS_DIR=./prompts
PREISE_FILE=./config/preise.yaml
CHECKPOINTER=sqlite
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=600
LOG_LEVEL=DEBUG
LOG_PAYLOADS=true
