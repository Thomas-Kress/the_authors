# ============================================================
# Roman-Agenten – Konfiguration
# Kopieren nach .env und Werte eintragen. .env niemals committen.
# Modellformat: <provider>:<modell>  (anthropic | openai | ollama)
# ============================================================

# --- API-Keys ------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=false

# --- Testprofil (nur .env.test) ----------------------------
# TEST_FALLBACK_MODEL=
# TEST_FALLBACK=false

# --- Defaults (gelten für jede Rolle ohne eigene Angabe) -----
DEFAULT_MODEL=anthropic:claude-sonnet-5-5
DEFAULT_TEMPERATURE=0.3
DEFAULT_MAX_TOKENS=8000

# --- Modelle pro Agent ---------------------------------------
AGENT_SHOWRUNNER_MODEL=anthropic:claude-sonnet-5-5
AGENT_SHOWRUNNER_TEMPERATURE=0.3
# AGENT_SHOWRUNNER_MAX_TOKENS=

AGENT_RESEARCH_MODEL=anthropic:claude-sonnet-5-5
AGENT_RESEARCH_TEMPERATURE=0.2
# AGENT_RESEARCH_MAX_TOKENS=
AGENT_RESEARCH_WEB_SEARCH=true
AGENT_RESEARCH_MAX_SEARCHES=10

AGENT_PLOT_ARCHITECT_MODEL=anthropic:claude-sonnet-5-5
AGENT_PLOT_ARCHITECT_TEMPERATURE=0.6
# AGENT_PLOT_ARCHITECT_MAX_TOKENS=

AGENT_CHAPTER_WRITER_MODEL=anthropic:claude-opus-5-5
AGENT_CHAPTER_WRITER_TEMPERATURE=0.85
AGENT_CHAPTER_WRITER_MAX_TOKENS=16000

AGENT_CONTINUITY_MODEL=anthropic:claude-sonnet-5-5
AGENT_CONTINUITY_TEMPERATURE=0.0
# AGENT_CONTINUITY_MAX_TOKENS=

AGENT_GUARDRAILS_MODEL=anthropic:claude-sonnet-5-5
AGENT_GUARDRAILS_TEMPERATURE=0.0
# AGENT_GUARDRAILS_MAX_TOKENS=

AGENT_LINE_EDITOR_MODEL=anthropic:claude-opus-5-5
AGENT_LINE_EDITOR_TEMPERATURE=0.4
AGENT_LINE_EDITOR_MAX_TOKENS=16000

AGENT_FULL_READ_MODEL=anthropic:claude-opus-5-5
AGENT_FULL_READ_TEMPERATURE=0.3
# AGENT_FULL_READ_MAX_TOKENS=

# Beispiel lokales Modell für eine einfache Rolle:
# AGENT_CONTINUITY_MODEL=ollama:qwen3:32b

# --- Pipeline ------------------------------------------------
MAX_REVISION_ROUNDS=3
WORD_COUNT_TOLERANCE=0.15
HUMAN_CHECKPOINTS=true

# --- Kosten & Effizienz --------------------------------------
ENABLE_PROMPT_CACHING=true
USE_BATCH_API=false
MAX_BUDGET_USD=200             # 0 = kein Limit

# --- Pfade ---------------------------------------------------
# Projektdaten (Bibles, Checkpoints, Ausgaben) liegen AUSSERHALB des Repos
PROJECTS_DIR=../roman-projekte
PROMPTS_DIR=./prompts
PREISE_FILE=./config/preise.yaml

# --- Betrieb -------------------------------------------------
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=300
CHECKPOINTER=sqlite            # sqlite | postgres
POSTGRES_URL=
LOG_LEVEL=INFO
LOG_PAYLOADS=false             # true = vollständige Prompts/Antworten in separate Dateien
